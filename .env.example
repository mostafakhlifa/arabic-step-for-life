# Arabic Step for Life — environment variables (placeholders only, never real secrets)
# Copy to .env and fill in real values. Never commit .env.

# PostgreSQL connection string (required)
DATABASE_URL=postgresql://user:password@localhost:5432/arabic_step_for_life?schema=public

# Session secret — long random string (required in production)
SESSION_SECRET=change-me-to-a-long-random-secret

# Server
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000
# Optional: restrict CORS origin (defaults to reflecting the request origin)
# CORS_ORIGIN=http://localhost:3000

# Stripe — TEST MODE ONLY. Never use live keys here.
STRIPE_TEST_MODE=true
STRIPE_SECRET_KEY=sk_test_your_test_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_test_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_test_webhook_secret

# SMTP (optional — contact emails and auth emails are skipped with a log line when unset)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.org
# Optional: address notified about new contact-form messages
CONTACT_NOTIFICATION_EMAIL=

# Seed / initial super admin (required by scripts/seed.js — never hardcode credentials)
SEED_ADMIN_EMAIL=admin@example.org
SEED_ADMIN_PASSWORD=change-me-strong-password
